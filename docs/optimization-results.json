    "probe_source": "package BatchProbe;\nuse strict;\nuse warnings;\nuse lib 'lib';\nuse Ham::CW::_Internal::PDL;\nmy $original = \\&Ham::CW::_Internal::PDL::frames;\nmy $cap = $ENV{HAM_CW_BENCH_BATCH};\ndie 'Invalid probe batch' unless defined($cap) && $cap =~ /\\A\\d+\\z/ && $cap > 0;\n{\n    no warnings 'redefine';\n    *Ham::CW::_Internal::PDL::frames = sub {\n        my ($self, $blocks) = @_;\n        for (my $i = 0; $i < @{$blocks}; $i += $cap) {\n            my $end = $i + $cap - 1;\n            $end = $#{$blocks} if $end > $#{$blocks};\n            $original->($self, [@{$blocks}[$i .. $end]]);\n        }\n        return;\n    };\n}\n1;\n",
